#include <iostream>
#include <vector>
#include "{{ project_slug }}/{{ project_slug }}.hpp"

using namespace {{ project_name }};

int main() {
    std::cout << "=== {{ project_name }} Basic Usage Example ===" << std::endl;

    // Calculator examples
    std::cout << "\nCalculator Examples:" << std::endl;
    std::cout << "2 + 3 = " << Calculator::add(2, 3) << std::endl;
    std::cout << "4 * 5 = " << Calculator::multiply(4, 5) << std::endl;
    std::cout << "10 / 2 = " << Calculator::divide(10, 2) << std::endl;

    try {
        Calculator::divide(5, 0);
    } catch (const std::invalid_argument& e) {
        std::cout << "Expected error for division by zero: " << e.what() << std::endl;
    }

    // String utility examples
    std::cout << "\nString Utility Examples:" << std::endl;
    std::string text = "apple,banana,cherry";
    auto fruits = string_utils::split(text, ',');

    std::cout << "Original: " << text << std::endl;
    std::cout << "Split: ";
    for (const auto& fruit : fruits) {
        std::cout << "[" << fruit << "] ";
    }
    std::cout << std::endl;

    std::string joined = string_utils::join(fruits, " | ");
    std::cout << "Joined back: " << joined << std::endl;

{% if cpp_standard == "C++20" %}
    // C++20 specific examples
    std::cout << "\nC++20 Examples:" << std::endl;
    std::cout << "Contains 'banana': " << std::boolalpha << string_utils::contains(text, "banana") << std::endl;
    std::cout << "Contains 'grape': " << std::boolalpha << string_utils::contains(text, "grape") << std::endl;
{% endif %}

    // Container utility examples
    std::cout << "\nContainer Utility Examples:" << std::endl;
    std::vector<int> numbers = {1, 3, 5, 7, 9};
    std::cout << "Vector: ";
    for (int num : numbers) {
        std::cout << num << " ";
    }
    std::cout << std::endl;

    std::cout << "Contains 5: " << std::boolalpha << container_utils::contains(numbers, 5) << std::endl;
    std::cout << "Contains 2: " << std::boolalpha << container_utils::contains(numbers, 2) << std::endl;

    // Practical example
    std::cout << "\nPractical Example:" << std::endl;
    std::string csv_data = "name,age,city";
    auto headers = string_utils::split(csv_data, ',');

    std::cout << "CSV Headers:" << std::endl;
    for (size_t i = 0; i < headers.size(); ++i) {
        std::cout << "  " << (i + 1) << ". " << headers[i] << std::endl;
    }

    std::cout << "\n=== Example Complete ===" << std::endl;
    return 0;
}