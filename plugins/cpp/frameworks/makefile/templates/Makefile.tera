# Makefile for {{ project_name }}
# Generated with Devora on {{ date }}

# Project configuration
PROJECT_NAME := {{ project_name | snake_case }}
CPP_STANDARD := {{ cpp_standard | regex_replace(pat="C\\+\\+", repl="") }}
BUILD_TYPE := {{ build_type }}
COMPILER := {{ compiler }}

# Directories
SRC_DIR := src
INC_DIR := include
BUILD_DIR := build
BIN_DIR := bin
TEST_DIR := tests

# Files
{% if project_type == "executable" %}
SOURCES := $(SRC_DIR)/main.cpp
TARGET := $(BIN_DIR)/$(PROJECT_NAME)
{% elif project_type == "static-lib" %}
SOURCES := $(SRC_DIR)/{{ project_name | snake_case }}.cpp
TARGET := $(BIN_DIR)/lib$(PROJECT_NAME).a
{% else %} {# shared-lib #}
SOURCES := $(SRC_DIR)/{{ project_name | snake_case }}.cpp
TARGET := $(BIN_DIR)/lib$(PROJECT_NAME).so
{% endif %}

# Compiler flags
CPPFLAGS := -std=c++$(CPP_STANDARD) -Wall -Wextra -pedantic

ifeq ($(BUILD_TYPE),Debug)
    CPPFLAGS += -g -O0 -DDEBUG
else
    CPPFLAGS += -O2 -DNDEBUG
endif

# Include directories
INCLUDES := -I$(INC_DIR)

# Linker flags
LDFLAGS :=
{% if project_type == "shared-lib" %}
LDFLAGS += -shared
{% endif %}

# Object files
OBJECTS := $(SOURCES:$(SRC_DIR)/%.cpp=$(BUILD_DIR)/%.o)

# Test files
{% if include_tests %}
TEST_SOURCES := $(TEST_DIR)/test_main.cpp
TEST_OBJECTS := $(TEST_SOURCES:$(TEST_DIR)/%.cpp=$(BUILD_DIR)/%.o)
TEST_TARGET := $(BIN_DIR)/tests
{% endif %}

# Default target
.PHONY: all clean test rebuild help install

all: $(TARGET)

# Create directories
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BIN_DIR):
	mkdir -p $(BIN_DIR)

# Compile source files
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp | $(BUILD_DIR)
	$(COMPILER) $(CPPFLAGS) $(INCLUDES) -c $< -o $@

{% if include_tests %}
# Compile test files
$(BUILD_DIR)/%.o: $(TEST_DIR)/%.cpp | $(BUILD_DIR)
	$(COMPILER) $(CPPFLAGS) $(INCLUDES) -c $< -o $@
{% endif %}

# Link executable
{% if project_type == "executable" %}
$(TARGET): $(OBJECTS) | $(BIN_DIR)
	$(COMPILER) $(OBJECTS) $(LDFLAGS) -o $@

{% elif project_type == "static-lib" %}
$(TARGET): $(OBJECTS) | $(BIN_DIR)
	ar rcs $@ $(OBJECTS)

{% else %} {# shared-lib #}
$(TARGET): $(OBJECTS) | $(BIN_DIR)
	$(COMPILER) $(OBJECTS) $(LDFLAGS) -o $@
{% endif %}

{% if include_tests %}
# Build tests
test: $(TEST_TARGET)

$(TEST_TARGET): $(OBJECTS) $(TEST_OBJECTS) | $(BIN_DIR)
	$(COMPILER) $(OBJECTS) $(TEST_OBJECTS) $(LDFLAGS) -o $@
	@echo "Running tests..."
	@./$(TEST_TARGET)

run-tests: $(TEST_TARGET)
	@echo "Running tests..."
	@./$(TEST_TARGET)
{% endif %}

# Clean build artifacts
clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR)

# Rebuild
rebuild: clean all

# Install (for libraries)
{% if project_type != "executable" %}
install: $(TARGET)
	@echo "Installing $(TARGET) to /usr/local/lib..."
	sudo cp $(TARGET) /usr/local/lib/
{% if project_type == "static-lib" %}
	sudo cp -r $(INC_DIR)/* /usr/local/include/
{% endif %}
	@echo "Installation complete!"
{% else %}
install: $(TARGET)
	@echo "Installing $(TARGET) to /usr/local/bin..."
	sudo cp $(TARGET) /usr/local/bin/
	@echo "Installation complete!"
{% endif %}

# Run executable
run: $(TARGET)
{% if project_type == "executable" %}
	@echo "Running $(PROJECT_NAME)..."
	@./$(TARGET)
{% else %}
	@echo "Cannot run library. Use 'make install' to install the library."
{% endif %}

# Help
help:
	@echo "Available targets:"
	@echo "  all        - Build the project"
{% if include_tests %}
	@echo "  test       - Build and run tests"
	@echo "  run-tests  - Run tests (if already built)"
{% endif %}
	@echo "  clean      - Remove build artifacts"
	@echo "  rebuild    - Clean and build"
	@echo "  install    - Install to system"
	@echo "  run        - Run the executable"
	@echo "  help       - Show this help message"
	@echo ""
	@echo "Build configuration:"
	@echo "  Project:   $(PROJECT_NAME)"
	@echo "  Standard:  C++$(CPP_STANDARD)"
	@echo "  Type:      {{ project_type }}"
	@echo "  Compiler:  $(COMPILER)"
	@echo "  Build:     $(BUILD_TYPE)"

# Debug information
debug:
	@echo "Project Configuration:"
	@echo "  Name:      $(PROJECT_NAME)"
	@echo "  Target:    $(TARGET)"
	@echo "  Sources:   $(SOURCES)"
	@echo "  Objects:   $(OBJECTS)"
	@echo "  Compiler:  $(COMPILER)"
	@echo "  Flags:     $(CPPFLAGS)"
	@echo "  Includes:  $(INCLUDES)"
	@echo "  Linker:    $(LDFLAGS)"