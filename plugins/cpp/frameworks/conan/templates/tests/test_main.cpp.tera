#include <catch2/catch_test_macros.hpp>
{% if project_type != "header-only" %}
#include "{{ project_name | snake_case }}/{{ project_name | snake_case }}.hpp"
{% else %}
#include "{{ project_name | snake_case }}/{{ project_name | snake_case }}.hpp"
{% endif %}

using namespace {{ project_name | title_case }};

TEST_CASE("Basic arithmetic operations", "[arithmetic]") {
    SECTION("Addition") {
        REQUIRE(add(2, 3) == 5);
        REQUIRE(add(-1, 1) == 0);
        REQUIRE(add(0, 0) == 0);
    }

    {% if project_type != "header-only" %}
    SECTION("Multiplication") {
        REQUIRE(multiply(2, 3) == 6);
        REQUIRE(multiply(-1, 1) == -1);
        REQUIRE(multiply(0, 5) == 0);
    }
    {% endif %}
}

{% if project_type == "header-only" %}
