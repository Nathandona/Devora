cmake_minimum_required(VERSION 3.15)

project({{ project_name | title_case }}
    VERSION 1.0.0
    DESCRIPTION "{{ description | default(value = "A C++ project with Conan") }}"
    LANGUAGES CXX)

list(APPEND CMAKE_MODULE_PATH ${CMAKE_BINARY_DIR})
list(APPEND CMAKE_PREFIX_PATH ${CMAKE_BINARY_DIR})

# Set C++ standard
set(CMAKE_CXX_STANDARD {{ cpp_standard | regex_replace(pat="C\\+\\+", repl="") }})
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Set build type
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE {{ build_type }})
endif()

# Compiler-specific options
if(MSVC)
    add_compile_options(/W4)
else()
    add_compile_options(-Wall -Wextra -Wpedantic)
endif()

{% if project_type == "executable" %}
# Executable target
add_executable({{ project_name | snake_case }})
target_sources({{ project_name | snake_case }}
    PRIVATE
        src/main.cpp
)

# Include directories
target_include_directories({{ project_name | snake_case }}
    PRIVATE
        include
)

# Link Conan dependencies
find_package(Catch2 REQUIRED)
target_link_libraries({{ project_name | snake_case }}
    PRIVATE
        Catch2::Catch2
)

{% elif project_type == "library" %}
# Library target
add_library({{ project_name | snake_case }})
target_sources({{ project_name | snake_case }}
    PRIVATE
        src/{{ project_name | snake_case }}.cpp
    PUBLIC
        include/{{ project_name | snake_case }}/{{ project_name | snake_case }}.hpp
)

# Include directories
target_include_directories({{ project_name | snake_case }}
    PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
        $<INSTALL_INTERFACE:include>
    PRIVATE
        src
)

# Set library properties
set_target_properties({{ project_name | snake_case }} PROPERTIES
    VERSION ${PROJECT_VERSION}
    SOVERSION ${PROJECT_VERSION_MAJOR}
)

# Link Conan dependencies
find_package(Catch2 REQUIRED)
target_link_libraries({{ project_name | snake_case }}
    PUBLIC
        Catch2::Catch2
)

{% else %} {# header-only #}
# Header-only library interface
add_library({{ project_name | snake_case }} INTERFACE)
target_include_directories({{ project_name | snake_case }}
    INTERFACE
        include
)

# Link Conan dependencies
find_package(Catch2 REQUIRED)
target_link_libraries({{ project_name | snake_case }}
    INTERFACE
        Catch2::Catch2
)

{% endif %}

{% if include_tests %}
# Enable testing
enable_testing()

# Test executable
add_executable(tests)
target_sources(tests
    PRIVATE
        tests/test_main.cpp
)

target_link_libraries(tests
    PRIVATE
        Catch2::Catch2WithMain
        {% if project_type != "header-only" %}{{ project_name | snake_case }}{% endif %}
)

# Include directories for tests
target_include_directories(tests
    PRIVATE
        include
        src
)

# Add tests
add_test(NAME AllTests COMMAND tests)

{% endif %}

# Installation
{% if project_type == "executable" %}
install(TARGETS {{ project_name | snake_case }}
    RUNTIME DESTINATION bin
)
{% elif project_type == "library" %}
install(TARGETS {{ project_name | snake_case }}
    EXPORT {{ project_name | title_case }}Targets
    LIBRARY DESTINATION lib
    ARCHIVE DESTINATION lib
    RUNTIME DESTINATION bin
)

install(DIRECTORY include/
    DESTINATION include
)

install(EXPORT {{ project_name | title_case }}Targets
    FILE {{ project_name | title_case }}Targets.cmake
    NAMESPACE {{ project_name | title_case }}::
    DESTINATION lib/cmake/{{ project_name | title_case }}
)

# Generate config file
include(CMakePackageConfigHelpers)
write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/{{ project_name | title_case }}ConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
)

configure_package_config_file(
    "${CMAKE_CURRENT_SOURCE_DIR}/cmake/{{ project_name | title_case }}Config.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/{{ project_name | title_case }}Config.cmake"
    INSTALL_DESTINATION lib/cmake/{{ project_name | title_case }}
)

install(FILES
    "${CMAKE_CURRENT_BINARY_DIR}/{{ project_name | title_case }}Config.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/{{ project_name | title_case }}ConfigVersion.cmake"
    DESTINATION lib/cmake/{{ project_name | title_case }}
)
{% endif %}