#include <iostream>
{% if project_type == "library" %}
#include "{{ project_name | snake_case }}/{{ project_name | snake_case }}.hpp"
{% endif %}

{% if include_tests %}
// Catch2 is available via Conan
#include <catch2/catch_test_macros.hpp>

// Example test in main file (usually tests go in separate files)
TEST_CASE("Quick sanity check", "[main]") {
    REQUIRE(1 + 1 == 2);
}
{% endif %}

int main() {
    std::cout << "Hello from {{ project_name }} (built with Conan)!" << std::endl;

{% if project_type == "library" %}
    // Example usage of the library
    auto result = {{ project_name | snake_case }}::add(2, 3);
    std::cout << "2 + 3 = " << result << std::endl;
{% endif %}

    return 0;
}